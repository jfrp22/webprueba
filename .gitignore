# ============================================================
# .gitignore — REDCHAMBU CA
# ============================================================

# ---- Sistema operativo ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Editores / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---- Node / npm (si en algún momento usas build tools) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ---- Sass / compilación (si compilas SCSS) ----
.sass-cache/
*.css.map
*.scss.map

# ---- Logs y temporales ----
*.log
*.tmp
*.bak
*.old
*.orig

# ---- Archivos de plantilla / demo que NO van al sitio ----
elements.html
generic.html
LICENSE.txt
README.txt
preview-template.html

# ---- Imágenes pesadas / borradores ----
# (descomenta si subes imágenes de trabajo que no quieres publicar)
# images/borradores/
# images/*.psd
# images/*.ai
# images/*.xcf

# ---- Variables de entorno / secretos ----
.env
.env.local
.env.*.local
*.key
secrets.json

# ---- Caché de herramientas ----
.cache/
.temp/
.tmp/

# ---- GitHub Pages ----
# No ignoramos nada de la raíz porque GitHub Pages sirve desde ahí
